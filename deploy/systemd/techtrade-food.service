[Unit]
Description=TechTrade.Food FastAPI Backend
After=network.target postgresql.service redis.service

[Service]
User=ubuntu
WorkingDirectory=/opt/techtrade-food/backend
EnvironmentFile=/opt/techtrade-food/backend/.env
ExecStart=/opt/techtrade-food/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target